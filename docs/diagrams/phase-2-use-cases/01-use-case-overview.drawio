        <mxCell id="e_37" value="تحقّق الدخول الداخلي&#xa;(ليس هوية وطنية)" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B06A00;strokeWidth=1.5;" edge="1" parent="1" source="uc01" target="sys_identity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_38" value="&lt;&lt;include&gt;&gt; Verify National ID&#xa;UC-01V" style="endArrow=block;endFill=1;dashed=1;html=1;strokeColor=#B06A00;strokeWidth=1.5;" edge="1" parent="1" source="uc05" target="sys_identity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_39" value="Execute Transaction&#xa;(Mock)" style="endArrow=block;endFill=1;dashed=1;html=1;strokeColor=#B06A00;strokeWidth=1.5;" edge="1" parent="1" source="uc28" target="sys_payment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_40" value="Notification Events" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B06A00;strokeWidth=1.5;" edge="1" parent="1" source="mod_12" target="sys_sms"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n1" value="توضيحات:&#xa;1) جميع حالات الاستخدام UC-01 حتى UC-04 (الهوية) متاحة لجميع المستخدمين بعد تسجيل الدخول.&#xa;2) UC-22 حتى UC-24 (الاستهلاك) يُنفّذها النظام تلقائياً (Actor نظامي) ولا يظهر له ممثل بشري.&#xa;3) UC-05 تشترط نتيجة تحقق ناجحة من Identity System Mock قبل إنشاء العميل.&#xa;4) الاسم الداخلي للدخول والصلاحيات = Identity Service (M1)، أما التحقق من الهوية الوطنية = نظام خارجي محاكى." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="410" y="1520" width="1690" height="130" as="geometry" /></mxCell>
      </root>
