        <mxCell id="m7" value="«جاري التحقق من المعاملة»" style="endArrow=block;endFill=1;html=1;strokeColor=#D0021B;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1831.5" y="280" as="sourcePoint" /><mxPoint x="1823.5" y="236" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="tm_note" value="السلوك المطلوب عند المهلة:&#xa;1) تحديث حالة المعاملة إلى PENDING_RECONCILIATION (لا FAILED) لأن الخدمة لا تعرف ما إذا نفذت أم لا.&#xa;2) تُمنع أي محاولة خصم ثانية بنفس idempotencyKey.&#xa;3) تُفتح تذكرة دعم تلقائية عند تجاوز 30 دقيقة دون مطابقة." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1500" height="110" as="geometry" /></mxCell>
